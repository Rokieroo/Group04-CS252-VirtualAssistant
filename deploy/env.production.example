# Copy to deploy/.env on the server and fill every value. Never commit deploy/.env.
# Generate passwords with: openssl rand -hex 24

# Public host name pointing at this server (A/AAAA record). Caddy gets the HTTPS
# certificate for it automatically on first start.
DOMAIN=learn.example.edu.vn
ACME_EMAIL=

# PostgreSQL: superuser (first init only), schema owner (migrations, backups),
# app role (API + worker; rows only).
POSTGRES_SUPERUSER_PASSWORD=
PATHLY_OWNER_PASSWORD=
PATHLY_APP_PASSWORD=
PATHLY_DB=pathly

# API
API_WORKERS=2
SESSION_MINUTES=720

# AI and search providers; empty keys keep the app offline-safe.
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
COMPANION_LLM_API_KEY=
COMPANION_LLM_MODEL=
YOUTUBE_API_KEY=
SEARCH_API_KEY=
WEB_SEARCH_API_KEY=

# Backups: host folder, copies kept, seconds between dumps
BACKUP_DIR=./backups
BACKUP_KEEP=7
BACKUP_INTERVAL_SECONDS=86400
