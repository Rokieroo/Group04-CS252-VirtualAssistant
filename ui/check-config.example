# Copy to .env.local inside ui/, then restart Vite.
# Without VITE_BACKEND_MODE the UI is the preview: everything runs in the browser, no server.
# VITE_BACKEND_MODE=api uses the real backend at VITE_API_URL (start it first).
# VITE_BACKEND_MODE=api
# VITE_API_URL=http://127.0.0.1:8000
# VITE_* values are public browser configuration. Never put secrets here.
